# ==============================================================================
# ENVIRONMENT CONFIGURATION - SIP-HALAL PLATFORM
# ==============================================================================

# Database Connection (Neon PostgreSQL Pooler)
DATABASE_URL="postgresql://user:password@host.aws.neon.tech/neondb?sslmode=require"

# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication Secret (HMAC & Session Encryption - 64+ char random string)
AUTH_SECRET="sip_halal_super_secret_auth_key_replace_this_in_production_min_64_characters"

# Object Storage Configuration (S3 / Cloudflare R2 / MinIO)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="sip-halal-documents"
STORAGE_REGION="auto"
STORAGE_PUBLIC_URL="http://localhost:3000/uploads"

# Application Environment
NODE_ENV="development"
